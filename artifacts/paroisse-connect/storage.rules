rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Avatars ─────────────────────────────────────────────────────────────
    // Tout utilisateur authentifié peut lire n'importe quel avatar.
    // Seul l'utilisateur peut écrire dans son propre dossier.
    match /avatars/{uid}/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024   // max 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Photos de paroisses ──────────────────────────────────────────────────
    // Lecture publique ; écriture réservée aux utilisateurs authentifiés.
    match /parishes/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024   // max 10 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Images d'annonces et d'événements ───────────────────────────────────
    match /announcements/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
    match /events/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Tout le reste : refus par défaut ────────────────────────────────────
    match /{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
